{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "frontend/ui/**/*.ts",
    "frontend/ui/**/*.vue",
    "vite.config.ts",
    "frontend/application/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.vue",
    "packages/plugin-sdk/**/*.ts",
    "packages/shader-ir/**/*.ts",
    "packages/workflow-tools/**/*.ts"
  ]
}
